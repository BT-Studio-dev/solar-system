@@ -0,0 +1,757 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Solar System Sandbox — a real solar system on Windows 7</title>
+<meta name="description" content="A real-time solar system simulator and N-body gravity sandbox for Windows 7 SP1 and later. JPL approximate ephemerides, five Aero themes, drop-in content folders, a 320 KB native app and a 2.2 MB installer.">
+<meta name="theme-color" content="#0b111f">
+<link rel="icon" href="assets/icon.ico" sizes="any">
+<link rel="canonical" href="https://testid001772.github.io/solar-system-sandbox-simulator/">
+<meta property="og:type" content="website">
+<meta property="og:site_name" content="Solar System Sandbox">
+<meta property="og:title" content="Solar System Sandbox — planets on real ephemerides, gravity on your terms">
+<meta property="og:description" content="40 bodies from JPL's approximate ephemerides, a velocity-Verlet N-body sandbox, five Aero themes and drop-in content folders — in a 320 KB Windows 7 app.">
+<meta property="og:url" content="https://testid001772.github.io/solar-system-sandbox-simulator/">
+<meta property="og:image" content="https://testid001772.github.io/solar-system-sandbox-simulator/docs/screenshots/overview.png">
+<meta name="twitter:card" content="summary_large_image">
+<style>
+/* ---------------------------------------------------------------- tokens */
+:root{
+  --bg0:#060911; --bg1:#0b111f; --bg2:#0c1424;
+  --panel:rgba(24,37,62,.72); --panel-2:rgba(15,24,41,.86);
+  --line:rgba(132,178,255,.16); --line-2:rgba(132,178,255,.30);
+  --text:#e8f0ff; --muted:#9eb0cd; --faint:#7d90ab;
+  --accent:#56a0ff; --accent-2:#8cc4ff; --deep:#2256a4;
+  --green:#68d6a8; --amber:#ffc46e; --violet:#b294ff;
+  --radius:16px; --radius-s:10px;
+  --shadow:0 24px 60px rgba(0,0,0,.45);
+  --font:"Segoe UI",-apple-system,BlinkMacSystemFont,Roboto,"Helvetica Neue",Arial,sans-serif;
+  --mono:"Consolas","Cascadia Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
+}
+*,*::before,*::after{box-sizing:border-box}
+html{scroll-behavior:smooth;color-scheme:dark}
+body{
+  margin:0;font-family:var(--font);color:var(--text);line-height:1.65;
+  background:
+    radial-gradient(1100px 700px at 12% 4%, rgba(44,26,78,.38), transparent 62%),
+    radial-gradient(1000px 760px at 92% 82%, rgba(28,52,104,.34), transparent 64%),
+    linear-gradient(180deg,var(--bg0) 0%,var(--bg1) 38%,var(--bg2) 100%);
+  background-attachment:fixed;
+  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
+  overflow-x:hidden;
+}
+body::before{
+  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.62;
+  background-image:url("data:image/svg+xml;base64,");
+  background-size:1400px 1000px;
+}
+::selection{background:rgba(86,160,255,.35);color:#fff}
+a{color:var(--accent-2);text-decoration:none}
+a:hover{text-decoration:underline;text-underline-offset:3px}
+h1,h2,h3{line-height:1.12;letter-spacing:-.02em;margin:0}
+p{margin:0}
+img{max-width:100%;display:block}
+code{font-family:var(--mono);font-size:.9em}
+:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px;border-radius:4px}
+.skip{position:absolute;left:-9999px;top:8px;z-index:99;background:#18253e;color:#fff;padding:10px 14px;border-radius:8px}
+.skip:focus{left:8px}
+
+/* ---------------------------------------------------------------- layout */
+.wrap{width:min(1180px,calc(100% - 40px));margin-inline:auto}
+main,header,footer{position:relative;z-index:1}
+.section{padding:76px 0;scroll-margin-top:86px}
+.section + .section{padding-top:12px}
+.section-head{max-width:720px;margin-bottom:30px}
+.eyebrow{
+  display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;
+  font-size:.78rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);
+}
+.eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px rgba(104,214,168,.8)}
+.section h2{font-size:clamp(1.7rem,3.2vw,2.4rem);font-weight:650}
+.section-head p{margin-top:12px;color:var(--muted);font-size:1.02rem}
+
+/* ---------------------------------------------------------------- topbar */
+.topbar{position:sticky;top:0;z-index:30;backdrop-filter:blur(16px) saturate(1.2);background:rgba(9,14,26,.78);border-bottom:1px solid var(--line)}
+.bar{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:66px}
+.brand{display:flex;align-items:center;gap:11px;color:var(--text);font-weight:650;letter-spacing:-.01em}
+.brand:hover{text-decoration:none}
+.brand-planet{position:relative;width:26px;height:26px;border-radius:50%;flex:none;background:radial-gradient(circle at 32% 30%,#bde0ff 0%,#6aa8ff 36%,#2b5fae 68%,#14284a 100%);box-shadow:0 0 18px rgba(86,160,255,.45)}
+.brand-planet::after{content:"";position:absolute;inset:9px -5px;border:1.5px solid rgba(190,220,255,.72);border-radius:50%;transform:rotate(-18deg)}
+.brand-text b{color:var(--accent-2);font-weight:650}
+.nav{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}
+.nav a{color:var(--muted);font-size:.91rem;font-weight:550;padding:8px 11px;border-radius:8px;display:inline-flex;align-items:center;gap:7px}
+.nav a:hover{color:var(--text);background:rgba(255,255,255,.05);text-decoration:none}
+.nav .nav-dl{color:var(--text);background:linear-gradient(180deg,rgba(46,66,102,.9),rgba(27,41,66,.9));border:1px solid var(--line-2);padding:7px 14px}
+.nav .nav-dl:hover{background:linear-gradient(180deg,rgba(62,88,132,.95),rgba(36,54,86,.95))}
+.nav svg{width:15px;height:15px}
+.nav button.nav-sound{display:inline-flex;align-items:center;gap:8px;padding:7px 11px;border:1px solid transparent;
+  border-radius:8px;background:transparent;color:var(--muted);font:inherit;font-size:.91rem;font-weight:550;
+  line-height:1;cursor:pointer;transition:color .15s,background .15s,border-color .15s}
+.nav button.nav-sound:hover{color:var(--text);background:rgba(255,255,255,.05)}
+.nav button.nav-sound:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.nav button.nav-sound[aria-pressed="true"]{color:var(--accent-2);border-color:var(--line-2);background:rgba(86,160,255,.1)}
+.nav-sound[hidden]{display:none}
+.nav-sound svg{width:15px;height:15px;flex:none}
+.nav-sound .spk-on{display:none}
+.nav-sound[aria-pressed="true"] .spk-off{display:none}
+.nav-sound[aria-pressed="true"] .spk-on{display:inline}
+.nav-sound .bars{display:none;align-items:flex-end;gap:2px;height:12px;margin-left:1px}
+.nav-sound[aria-pressed="true"] .bars{display:inline-flex}
+.nav-sound .bars i{width:2px;height:4px;border-radius:1px;background:currentColor;animation:eq 1.7s ease-in-out infinite}
+.nav-sound .bars i:nth-child(2){animation-delay:.28s}
+.nav-sound .bars i:nth-child(3){animation-delay:.56s}
+@keyframes eq{0%,100%{height:3px}50%{height:11px}}
+@media (prefers-reduced-motion:reduce){.nav-sound .bars i{animation:none;height:6px}}
+
+/* ---------------------------------------------------------------- hero */
+.hero{position:relative;padding:72px 0 40px;overflow:hidden}
+.hero::before{
+  content:"";position:absolute;inset:-140px -20% auto -20%;height:820px;pointer-events:none;
+  background:
+    radial-gradient(620px 420px at 22% 34%, rgba(78,48,130,.32), transparent 70%),
+    radial-gradient(760px 520px at 82% 22%, rgba(38,86,164,.28), transparent 70%);
+}
+.hero-grid{position:relative;display:grid;grid-template-columns:1.02fr .98fr;gap:52px;align-items:center}
+.hero h1{font-size:clamp(2.5rem,5.1vw,4.15rem);font-weight:680;letter-spacing:-.035em}
+.hero h1 .line2{display:block;background:linear-gradient(92deg,#8cc4ff 0%,#b294ff 52%,#68d6a8 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
+.lede{margin-top:20px;color:var(--muted);font-size:1.09rem;max-width:54ch}
+.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
+.btn{
+  display:inline-flex;align-items:center;gap:10px;padding:12px 18px;border-radius:10px;
+  border:1px solid var(--line-2);color:var(--text);font-weight:650;font-size:.97rem;
+  background:linear-gradient(180deg,rgba(46,66,102,.95),rgba(27,41,66,.95));
+  box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 10px 24px rgba(0,0,0,.28);
+  transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease;
+}
+.btn:hover{text-decoration:none;transform:translateY(-1px);border-color:rgba(170,214,255,.5);box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 14px 30px rgba(0,0,0,.32)}
+.btn:active{transform:translateY(0)}
+.btn svg{width:18px;height:18px;flex:none}
+.btn .sub{font-weight:500;font-size:.82em;color:rgba(232,240,255,.72)}
+.btn.primary{
+  background:linear-gradient(180deg,#6cb2ff 0%,#3d86e8 48%,#2256a4 100%);
+  border-color:rgba(170,214,255,.6);color:#fff;
+  box-shadow:0 14px 34px rgba(38,110,220,.38),inset 0 1px 0 rgba(255,255,255,.35);
+}
+.btn.primary:hover{box-shadow:0 18px 40px rgba(38,110,220,.46),inset 0 1px 0 rgba(255,255,255,.4)}
+.btn.primary .sub{color:rgba(255,255,255,.85)}
+.meta{display:flex;flex-wrap:wrap;gap:8px 18px;list-style:none;margin:22px 0 0;padding:0;color:var(--faint);font-size:.86rem}
+.meta li{display:flex;align-items:center;gap:7px}
+.meta li::before{content:"";width:4px;height:4px;border-radius:50%;background:rgba(140,196,255,.6)}
+.hero-figure{position:relative;margin:0;isolation:isolate}
+.hero-figure::before{
+  content:"";position:absolute;inset:12% 6% -8% 6%;z-index:-1;border-radius:50%;
+  background:radial-gradient(closest-side,rgba(86,160,255,.34),transparent 72%);filter:blur(24px);
+}
+.frame{
+  border-radius:14px;padding:7px;border:1px solid var(--line-2);
+  background:linear-gradient(180deg,rgba(46,66,102,.55),rgba(12,20,36,.75));
+  box-shadow:var(--shadow),inset 0 1px 0 rgba(255,255,255,.14);
+}
+.frame img{border-radius:9px;width:100%;height:auto;border:1px solid rgba(0,0,0,.35)}
+.hero-figure figcaption{margin-top:12px;color:var(--faint);font-size:.82rem;display:flex;justify-content:space-between;gap:12px}
+.hero-figure figcaption b{color:var(--muted);font-weight:600}
+
+/* ---------------------------------------------------------------- stats */
+.stats{margin-top:44px}
+.stats-inner{
+  display:grid;grid-template-columns:repeat(5,1fr);gap:2px;overflow:hidden;
+  border:1px solid var(--line);border-radius:var(--radius);
+  background:linear-gradient(180deg,rgba(24,37,62,.66),rgba(15,24,41,.8));
+  box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
+}
+.stat{padding:20px 18px;text-align:center;border-left:1px solid var(--line)}
+.stat:first-child{border-left:0}
+.stat b{display:block;font-size:1.65rem;font-weight:680;letter-spacing:-.02em;background:linear-gradient(180deg,#eaf2ff,#9cc6ff);-webkit-background-clip:text;background-clip:text;color:transparent}
+.stat span{display:block;margin-top:2px;color:var(--faint);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
+
+/* ---------------------------------------------------------------- cards */
+.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
+.card{
+  position:relative;padding:24px 22px 22px;border-radius:var(--radius);overflow:hidden;
+  border:1px solid var(--line);background:linear-gradient(180deg,rgba(24,37,62,.74),rgba(15,24,41,.86));
+  box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 14px 30px rgba(0,0,0,.18);
+  transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease;
+}
+.card::before{content:"";position:absolute;inset:0 0 auto;height:1px;background:linear-gradient(90deg,transparent,rgba(140,196,255,.35),transparent);opacity:.7}
+.card:hover{transform:translateY(-3px);border-color:rgba(132,178,255,.32);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 20px 40px rgba(0,0,0,.28)}
+.card .ico{
+  width:38px;height:38px;border-radius:10px;display:grid;place-items:center;margin-bottom:16px;
+  color:var(--accent-2);border:1px solid rgba(132,178,255,.22);
+  background:linear-gradient(180deg,rgba(86,160,255,.18),rgba(34,86,164,.12));
+}
+.card .ico svg{width:20px;height:20px}
+.card h3{font-size:1.05rem;font-weight:650;margin-bottom:7px}
+.card p{color:var(--muted);font-size:.93rem}
+
