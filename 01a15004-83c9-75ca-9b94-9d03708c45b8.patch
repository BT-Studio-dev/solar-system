+/* sim.c -- solar system model, ephemeris and sandbox physics. */
+#include "sim.h"
+
+#include <math.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define SIM_COLLIDE_MUL 300.0
