+static int alive_body_at(const App *app, int k) {
+    int n = 0;
+    for (int i = 0; i < app->sim.count; i++) {
+        if (!app->sim.bodies[i].alive) continue;
+        if (n == k) return i;
+        n++;
+    }
+    return -1;
+}
