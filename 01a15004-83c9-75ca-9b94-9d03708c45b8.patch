@@ -0,0 +1,99 @@
+/* content.h -- drop-in content folders: Parts, Texture Pack, Mods, Assets,
+ * plus the writable Logs and Saving folders.
+ *
+ * Layout (the same names are used next to the executable and in the user's
+ * %APPDATA% folder, so a portable copy and an installed copy behave alike):
+ *
+ *   Assets/                 images, fonts, anything the shell can show
+ *   Parts/                  body templates for the "Create body" panel (.part)
+ *   Texture Pack/<name>/    pack.ini plus optional textures; recolours the scene
+ *   Mods/Custom_/           extra scenarios (.sims), listed in the Library tab
+ *   Logs/app.log            timestamped application log
+ *   Saving/                 default folder for saved simulations (.sims)
+ *
+ * The parser is deliberately small and tolerant: "key=value" lines, '#' at the
+ * start of a line is a comment, unknown keys are ignored so new keys can be
+ * added without breaking older builds.
+ */
+#ifndef SSS_CONTENT_H
+#define SSS_CONTENT_H
+
+#include "core.h"
+
+#define CONTENT_MAX_PARTS 64
+#define CONTENT_MAX_PACKS 16
+#define CONTENT_MAX_MODS 64
+#define CONTENT_PATH 260
+#define CONTENT_NAME 64
+#define CONTENT_NOTE 96
+
+typedef enum {
+    CF_ASSETS = 0,
+    CF_PARTS,
+    CF_TEXTURE_PACKS,
+    CF_MODS,
+    CF_LOGS,
+    CF_SAVING,
+    CF_COUNT
+} ContentFolder;
+
+typedef struct {
+    char name[CONTENT_NAME];
+    char kind[16];              /* star, terrestrial, giant, ice, dwarf, asteroid, comet */
+    double mass_kg;
+    double radius_km;
+    double orbit_au;            /* 0 = no orbit field shown */
+    double ecc;
+    SsColor col1, col2, accent;
+    int ringed;
+    double ring_in, ring_out;
+    SsColor ring_col;
+    char note[CONTENT_NOTE];
+    char file[CONTENT_PATH];    /* UTF-8 path the part was read from */
+} ContentPart;
+
+typedef struct {
+    char name[CONTENT_NAME];
+    char note[CONTENT_NOTE];
+    SsColor tint;
+    int strength;               /* 0-100, how far body colours move to the tint */
+    char file[CONTENT_PATH];
+} ContentPack;
+
+typedef struct {
+    char name[CONTENT_NAME];
+    char file[CONTENT_PATH];
+} ContentMod;
+
+/* app_root: folder next to the executable (may be read-only when installed).
+ * user_root: writable per-user folder. Either may be NULL. */
+int content_init(const char *app_root, const char *user_root);
+void content_shutdown(void);
+
+/* Rescan the content folders. Safe to call at any time. */
+void content_scan(void);
+
+/* UTF-8 path of a folder. content_dir() prefers the writable user root,
+ * content_app_dir() the folder next to the executable ("" when unknown). */
+const char *content_dir(int folder);
+const char *content_app_dir(int folder);
+/* UTF-8 path of the writable root ("...\\Solar System Sandbox"). */
+const char *content_user_root(void);
+
+int content_part_count(void);
+const ContentPart *content_part(int index);
+int content_pack_count(void);
+const ContentPack *content_pack(int index);
+int content_mod_count(void);
+const ContentMod *content_mod(int index);
+
+/* "giant" -> BT_GIANT. Returns -1 for unknown names. */
+int content_kind_from_name(const char *name);
+
+/* Appends one line "<time> <message>" to <user root>/Logs/app.log. */
+void content_log(const char *fmt, ...);
+
+/* Colour helper shared with the parser and the UI ("#rrggbb" or "r,g,b"). */
+int content_parse_color(const char *text, SsColor *out);
+
+#endif
diff --git a/src/core.c b/src/core.c
new file mode 100644
index 0000000..f38f9b3
--- /dev/null
+++ b/src/core.c
@@ -0,0 +1,334 @@
+/* core.c -- implementation of platform-neutral helpers. */
+#include "core.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <math.h>
+
+/* ------------------------------------------------------------- allocations */
+
+#ifdef SSS_WINDOWS
+#include <windows.h>
+void *sss_alloc(size_t bytes) { return HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, bytes); }
+void *sss_realloc(void *ptr, size_t bytes) {
+    if (!ptr) return sss_alloc(bytes);
+    return HeapReAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ptr, bytes);
+}
+void sss_free(void *ptr) { if (ptr) HeapFree(GetProcessHeap(), 0, ptr); }
+#else
+void *sss_alloc(size_t bytes) { return calloc(1, bytes); }
+void *sss_realloc(void *ptr, size_t bytes) {
+    void *p = realloc(ptr, bytes);
+    return p;
+}
+void sss_free(void *ptr) { free(ptr); }
+#endif
+
+/* ----------------------------------------------------------- string builder */
+
+void str_init(Str *s, char *storage, int cap) {
+    s->data = storage;
+    s->cap = cap;
+    s->len = 0;
+    if (cap > 0) storage[0] = 0;
+}
+
+void str_clear(Str *s) {
+    s->len = 0;
+    if (s->cap > 0) s->data[0] = 0;
+}
+
+void str_addn(Str *s, const char *text, int n) {
+    if (!text || n <= 0 || s->len >= s->cap - 1) return;
+    if (n > s->cap - 1 - s->len) n = s->cap - 1 - s->len;
+    memcpy(s->data + s->len, text, (size_t)n);
+    s->len += n;
+    s->data[s->len] = 0;
+}
+
+void str_add(Str *s, const char *text) {
+    if (!text) return;
+    str_addn(s, text, (int)strlen(text));
+}
+
+void str_addc(Str *s, char c) { str_addn(s, &c, 1); }
+
+void str_add_pad(Str *s, int spaces) {
+    while (spaces-- > 0) str_addc(s, ' ');
+}
+
+void str_add_int(Str *s, long long value) {
+    char tmp[32];
+    int n = 0;
+    unsigned long long u;
+    int neg = value < 0;
+    u = neg ? (unsigned long long)(-(value + 1)) + 1ull : (unsigned long long)value;
+    do {
+        tmp[n++] = (char)('0' + (int)(u % 10));
+        u /= 10;
+    } while (u && n < (int)sizeof(tmp) - 2);
+    if (neg) str_addc(s, '-');
+    while (n > 0) str_addc(s, tmp[--n]);
+}
+
+void str_add_commas(Str *s, long long value) {
+    char tmp[32];
+    int n = 0;
+    unsigned long long u;
+    int neg = value < 0;
+    u = neg ? (unsigned long long)(-(value + 1)) + 1ull : (unsigned long long)value;
+    do {
+        tmp[n++] = (char)('0' + (int)(u % 10));
+        u /= 10;
+    } while (u && n < (int)sizeof(tmp) - 2);
+    if (neg) str_addc(s, '-');
+    for (int i = n - 1; i >= 0; i--) {
+        str_addc(s, tmp[i]);
+        if (i > 0 && (i % 3) == 0) str_addc(s, ',');
+    }
+}
+
+void str_add_float(Str *s, double value, int decimals) {
+    if (decimals < 0) decimals = 0;
+    if (decimals > 9) decimals = 9;
+    int neg = value < 0;
+    double v = neg ? -value : value;
+    if (!(v == v)) { str_add(s, "n/a"); return; }
+    if (v >= 1e15) {
+        /* scientific notation keeps ephemeris-scale values exact and parseable */
+        int exp = 0;
+        while (v >= 10.0) { v /= 10.0; exp++; }
+        str_add_float(s, neg ? -v : v, decimals < 6 ? 6 : decimals);
+        str_addc(s, 'e');
+        str_addc(s, '+');
+        str_add_int(s, exp);
+        return;
+    }
+    unsigned long long scale = 1;
+    for (int i = 0; i < decimals; i++) scale *= 10ull;
+    unsigned long long iv = (unsigned long long)(v + 0.5 / (double)scale);
+    unsigned long long frac = 0;
+    if (decimals > 0) {
+        double f = (v - (double)(unsigned long long)v) * (double)scale;
+        frac = (unsigned long long)(f + 0.5);
+        if (frac >= scale) { frac = 0; iv += 1; }
+    }
+    if (neg && (iv != 0 || frac != 0)) str_addc(s, '-');
+    str_add_int(s, (long long)iv);
+    if (decimals > 0) {
+        str_addc(s, '.');
+        char tmp[12];
+        for (int i = decimals - 1; i >= 0; i--) {
+            tmp[i] = (char)('0' + (int)(frac % 10ull));
+            frac /= 10ull;
+        }
+        str_addn(s, tmp, decimals);
+    }
+}
+
+const char *str_cstr(Str *s) { return s->data; }
+
+/* ------------------------------------------------------------ utf helpers */
+
+int utf8_to_utf16(const char *in, int in_len, wchar_t *out, int out_cap) {
+    int i = 0, o = 0;
+    if (in_len < 0) in_len = (int)strlen(in);
+    while (i < in_len) {
+        unsigned char c = (unsigned char)in[i++];
+        uint32_t cp;
+        if (c < 0x80) cp = c;
+        else if ((c & 0xE0) == 0xC0 && i < in_len) cp = ((uint32_t)(c & 0x1F) << 6) | (in[i++] & 0x3F);
+        else if ((c & 0xF0) == 0xE0 && i + 1 < in_len)
+            cp = ((uint32_t)(c & 0x0F) << 12) | ((uint32_t)(in[i] & 0x3F) << 6) | (in[i + 1] & 0x3F), i += 2;
+        else if ((c & 0xF8) == 0xF0 && i + 2 < in_len) {
+            cp = ((uint32_t)(c & 0x07) << 18) | ((uint32_t)(in[i] & 0x3F) << 12) |
+                 ((uint32_t)(in[i + 1] & 0x3F) << 6) | (in[i + 2] & 0x3F);
+            i += 3;
+        } else cp = 0xFFFD;
+        if (o + 1 >= out_cap) break;
+        if (cp >= 0x10000) {
+            if (o + 2 >= out_cap) break;
+            cp -= 0x10000;
+            out[o++] = (wchar_t)(0xD800 + (cp >> 10));
+            out[o++] = (wchar_t)(0xDC00 + (cp & 0x3FF));
+        } else {
+            out[o++] = (wchar_t)cp;
+        }
+    }
+    if (out_cap > 0) out[o < out_cap ? o : out_cap - 1] = 0;
+    return o;
+}
+
+int utf16_to_utf8(const wchar_t *in, int in_len, char *out, int out_cap) {
+    int i = 0, o = 0;
+    if (in_len < 0) {
+        in_len = 0;
+        while (in[in_len]) in_len++;
+    }
+    while (i < in_len) {
+        uint32_t cp = (uint16_t)in[i++];
+        if (cp >= 0xD800 && cp <= 0xDBFF && i < in_len) {
+            uint32_t lo = (uint16_t)in[i];
+            if (lo >= 0xDC00 && lo <= 0xDFFF) {
+                cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
+                i++;
+            }
+        }
+        unsigned char buf[4];
+        int n;
+        if (cp < 0x80) { buf[0] = (unsigned char)cp; n = 1; }
+        else if (cp < 0x800) { buf[0] = (unsigned char)(0xC0 | (cp >> 6)); buf[1] = (unsigned char)(0x80 | (cp & 0x3F)); n = 2; }
+        else if (cp < 0x10000) {
+            buf[0] = (unsigned char)(0xE0 | (cp >> 12));
+            buf[1] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F));
+            buf[2] = (unsigned char)(0x80 | (cp & 0x3F));
+            n = 3;
+        } else {
+            buf[0] = (unsigned char)(0xF0 | (cp >> 18));
+            buf[1] = (unsigned char)(0x80 | ((cp >> 12) & 0x3F));
+            buf[2] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F));
+            buf[3] = (unsigned char)(0x80 | (cp & 0x3F));
+            n = 4;
+        }
+        if (o + n >= out_cap) break;
+        memcpy(out + o, buf, (size_t)n);
+        o += n;
+    }
+    if (out_cap > 0) out[o < out_cap ? o : out_cap - 1] = 0;
+    return o;
+}
+
+/* ---------------------------------------------------------------- math */
+
+double clampd(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }
+double lerpd(double a, double b, double t) { return a + (b - a) * t; }
+double smoothstepd(double t) {
+    t = clampd(t, 0, 1);
+    return t * t * (3 - 2 * t);
+}
+float lerpf(float a, float b, float t) { return a + (b - a) * t; }
+float ease_out_cubic(float t) {
+    if (t < 0) t = 0;
+    if (t > 1) t = 1;
+    float f = 1.0f - t;
+    return 1.0f - f * f * f;
+}
+
+/* ----------------------------------------------------------------- dates */
+
+double wall_days_since_j2000(void) {
+#ifdef SSS_WINDOWS
+    FILETIME ft;
+    GetSystemTimeAsFileTime(&ft);
+    unsigned long long t = ((unsigned long long)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    /* 100ns ticks since 1601-01-01; JD of that epoch is 2305812.5 */
+    double seconds = (double)t / 1e7;
+    return 2305812.5 + seconds / 86400.0 - 2451545.0;
+#else
+    extern long time(long *);
+    long secs = time(0);
+    return (double)secs / 86400.0 + 2440587.5 - 2451545.0;
+#endif
+}
+
+double date_to_jd(int year, int month, int day, int hour, int minute, int second) {
+    /* Julian Day Number for the Gregorian calendar, then J2000 offset. */
+    int a = (14 - month) / 12;
+    int y = year + 4800 - a;
+    int m = month + 12 * a - 3;
+    long jdn = day + (153 * m + 2) / 5 + 365L * y + y / 4 - y / 100 + y / 400 - 32045;
+    double frac = ((double)hour - 12.0 + (double)minute / 60.0 + (double)second / 3600.0) / 24.0;
+    return (double)jdn + frac - 2451545.0;
+}
+
+void jd_to_date(double days, int *year, int *month, int *day, int *hour, int *minute, int *second) {
+    double jd = 2451545.0 + days + 0.5;
+    double Zf = floor(jd);
+    double F = jd - Zf;
+    long long Z = (long long)Zf;
+    long long A = Z;
+    if (Z >= 2299161) {
+        long long alpha = (long long)((Zf - 1867216.25) / 36524.25);
+        A = Z + 1 + alpha - alpha / 4;
+    }
+    long long B = A + 1524;
+    long long C = (long long)((B - 122.1) / 365.25);
+    long long D = (long long)(365.25 * (double)C);
+    long long E = (long long)((B - D) / 30.6001);
+    double dayf = (double)(B - D - (long long)(30.6001 * (double)E)) + F;
+    int mon = (int)(E < 14 ? E - 1 : E - 13);
+    int yr = (int)(mon > 2 ? C - 4716 : C - 4715);
+    int dayi = (int)dayf;
+    double frac = dayf - dayi;
+    int secs = (int)(frac * 86400.0 + 0.5);
+    if (secs >= 86400) { secs -= 86400; dayi += 1; }
+    int hh = secs / 3600, mm = (secs / 60) % 60, ss = secs % 60;
+    if (year) *year = yr;
+    if (month) *month = mon;
+    if (day) *day = dayi;
+    if (hour) *hour = hh;
+    if (minute) *minute = mm;
+    if (second) *second = ss;
+}
+
+/* --------------------------------------------------------------- formatting */
+
+const char *fmt_compact(double v, int decimals, char *buf, int cap) {
+    Str s;
+    str_init(&s, buf, cap);
+    double a = v < 0 ? -v : v;
+    if (a >= 1e12) { str_add_float(&s, v / 1e12, decimals); str_add(&s, "T"); }
+    else if (a >= 1e9) { str_add_float(&s, v / 1e9, decimals); str_add(&s, "B"); }
+    else if (a >= 1e6) { str_add_float(&s, v / 1e6, decimals); str_add(&s, "M"); }
+    else if (a >= 1e4) { str_add_float(&s, v / 1e3, decimals); str_add(&s, "k"); }
+    else str_add_float(&s, v, decimals);
+    return buf;
+}
+
+const char *fmt_commas(double v, int decimals, char *buf, int cap) {
+    Str s;
+    str_init(&s, buf, cap);
+    int neg = v < 0;
+    double a = neg ? -v : v;
+    double ip = floor(a);
+    int frac = (int)((a - ip) * 1000.0 + 0.5);
+    unsigned long long scale = 1;
+    for (int i = 0; i < decimals; i++) scale *= 10ull;
+    if (decimals == 0) {
+        if (neg) str_addc(&s, '-');
+        str_add_commas(&s, (long long)(a + 0.5));
+        return buf;
+    }
+    if (frac >= 1000) { frac = 0; ip += 1; }
+    char tmp[8];
+    for (int i = 0; i < 3; i++) { tmp[2 - i] = (char)('0' + frac % 10); frac /= 10; }
+    tmp[3] = 0;
+    if (neg && (ip > 0 || frac > 0)) str_addc(&s, '-');
+    str_add_commas(&s, (long long)ip);
+    str_addc(&s, '.');
+    str_addn(&s, tmp, decimals);
+    return buf;
+}
+
+const char *fmt_hm(double hours, char *buf, int cap) {
+    Str s;
+    str_init(&s, buf, cap);
+    if (hours < 0) { str_addc(&s, '-'); hours = -hours; }
+    if (hours < 48) {
+        int h = (int)hours;
+        int m = (int)((hours - h) * 60.0 + 0.5);
+        str_add_int(&s, h);
+        str_add(&s, "h ");
+        str_add_int(&s, m);
+        str_add(&s, "m");
+    } else if (hours < 24 * 365.25) {
+        double d = hours / 24.0;
+        str_add_float(&s, d, d < 10 ? 1 : 0);
+        str_add(&s, "d");
+    } else {
+        str_add_float(&s, hours / (24.0 * 365.25), 2);
+        str_add(&s, "y");
+    }
+    return buf;
+}
diff --git a/src/core.h b/src/core.h
new file mode 100644
index 0000000..05d5687
--- /dev/null
+++ b/src/core.h
@@ -0,0 +1,198 @@
+/* core.h -- platform-neutral foundation types and helpers.
+ *
+ * Solar System Sandbox Simulator
+ * Target: Windows 7 SP1 and later (32-bit), also builds for the headless
+ * software-rendering harness on Linux for automated screenshot tests.
+ */
+#ifndef SSS_CORE_H
+#define SSS_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <wchar.h>
+
+#ifdef _WIN32
+#define SSS_WINDOWS 1
+#else
+#define SSS_LINUX 1
+#endif
+
+#define SSS_VERSION_MAJOR 1
+#define SSS_VERSION_MINOR 0
+#define SSS_VERSION_PATCH 0
+#define SSS_VERSION_STRING "1.0.0"
+#define SSS_VERSION_WSTRING L"1.0.0"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#define TAU (2.0 * M_PI)
+#define DEG2RAD (M_PI / 180.0)
+#define RAD2DEG (180.0 / M_PI)
+
+/* ------------------------------------------------------------------ basics */
+
+typedef struct {
+    float x, y;
+} Vec2;
+
+typedef struct {
+    double x, y, z;
+} Vec3;
+
+typedef struct {
+    float x, y, w, h;
+} SsRect;
+
+typedef struct {
+    float l, t, r, b;
+} Insets;
+
+/* 0xAARRGGBB */
+typedef uint32_t SsColor;
+
+#define RGB_A(r, g, b) ((SsColor)(0xFF000000u | ((uint32_t)(r) << 16) | ((uint32_t)(g) << 8) | (uint32_t)(b)))
+#define RGBA(r, g, b, a) ((SsColor)(((uint32_t)(a) << 24) | ((uint32_t)(r) << 16) | ((uint32_t)(g) << 8) | (uint32_t)(b)))
+#define COL_A(c) ((uint8_t)(((c) >> 24) & 0xFF))
+#define COL_R(c) ((uint8_t)(((c) >> 16) & 0xFF))
+#define COL_G(c) ((uint8_t)(((c) >> 8) & 0xFF))
+#define COL_B(c) ((uint8_t)((c) & 0xFF))
+
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#define CLAMP(v, lo, hi) ((v) < (lo) ? (lo) : ((v) > (hi) ? (hi) : (v)))
+#define ABSF(v) ((v) < 0 ? -(v) : (v))
+#define ARRAY_LEN(a) ((int)(sizeof(a) / sizeof((a)[0])))
+
+static inline int ifloor(double v) {
+    int i = (int)v;
+    return (v < 0 && (double)i != v) ? i - 1 : i;
+}
+
+static inline SsColor col_blend(SsColor a, SsColor b, float t) {
+    if (t <= 0.0f) return a;
+    if (t >= 1.0f) return b;
+    int aa = (int)COL_A(a), ar = (int)COL_R(a), ag = (int)COL_G(a), ab = (int)COL_B(a);
+    int ba = (int)COL_A(b), br = (int)COL_R(b), bg = (int)COL_G(b), bb = (int)COL_B(b);
+    return RGBA(ar + (int)((br - ar) * t), ag + (int)((bg - ag) * t),
+                ab + (int)((bb - ab) * t), aa + (int)((ba - aa) * t));
+}
+
+static inline SsColor col_alpha(SsColor c, float mul) {
+    int a = (int)(COL_A(c) * (mul < 0 ? 0 : (mul > 1 ? 1 : mul)) + 0.5f);
+    return (c & 0x00FFFFFFu) | ((uint32_t)a << 24);
+}
+
+static inline SsColor col_with_alpha(SsColor c, int a) {
+    return (c & 0x00FFFFFFu) | ((uint32_t)CLAMP(a, 0, 255) << 24);
+}
+
+static inline SsRect rect_make(float x, float y, float w, float h) {
+    SsRect r;
+    r.x = x; r.y = y; r.w = w; r.h = h;
+    return r;
+}
+
+static inline SsRect rect_inset(SsRect r, float d) {
+    r.x += d; r.y += d; r.w -= d * 2; r.h -= d * 2;
+    if (r.w < 0) r.w = 0;
+    if (r.h < 0) r.h = 0;
+    return r;
+}
+
+static inline SsRect rect_insets(SsRect r, Insets in) {
+    r.x += in.l; r.y += in.t; r.w -= in.l + in.r; r.h -= in.t + in.b;
+    return r;
+}
+
+static inline SsRect rect_offset(SsRect r, float dx, float dy) {
+    r.x += dx; r.y += dy;
+    return r;
+}
+
+static inline int rect_contains(SsRect r, float x, float y) {
+    return x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h;
+}
+
+static inline int rect_intersect(SsRect a, SsRect b, SsRect *out) {
+    float l = MAX(a.x, b.x), t = MAX(a.y, b.y);
+    float r = MIN(a.x + a.w, b.x + b.w), bo = MIN(a.y + a.h, b.y + b.h);
+    if (r <= l || bo <= t) return 0;
+    if (out) { out->x = l; out->y = t; out->w = r - l; out->h = bo - t; }
+    return 1;
+}
+
+static inline SsRect rect_center(SsRect outer, float w, float h) {
+    return rect_make(outer.x + (outer.w - w) * 0.5f, outer.y + (outer.h - h) * 0.5f, w, h);
+}
+
+static inline SsRect rect_split_top(SsRect *r, float h) {
+    SsRect top = rect_make(r->x, r->y, r->w, h);
+    r->y += h; r->h -= h;
+    return top;
+}
+
+static inline SsRect rect_with_h(SsRect r, float h) {
+    r.h = h;
+    return r;
+}
+
+static inline Vec2 vec2(float x, float y) {
+    Vec2 v; v.x = x; v.y = y;
+    return v;
+}
+
+static inline float vec2_len(Vec2 v) { return (float)__builtin_sqrt((double)(v.x * v.x + v.y * v.y)); }
+
+/* ------------------------------------------------------------- allocations */
+/* The app avoids the CRT heap on Windows; these map to the platform allocator. */
+
+void *sss_alloc(size_t bytes);
+void *sss_realloc(void *ptr, size_t bytes);
+void sss_free(void *ptr);
