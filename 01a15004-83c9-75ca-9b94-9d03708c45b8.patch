+<script>
+/* Ambient soundtrack for the landing page.
+   A handful of slowly drifting sine voices through a small generated reverb,
+   plus a low wind bed. Nothing is fetched: the whole piece is synthesised
+   from oscillators the moment the speaker button is switched on. */
+(function () {
+  'use strict';
+
+  var btn = document.getElementById('sound');
+  if (!btn) return;
+  var AC = window.AudioContext || window.webkitAudioContext;
+  if (!AC) return;
+
+  var CHORDS = [
+    [110.00, 164.81, 220.00, 277.18, 329.63], /* A minor add9 */
+    [87.31, 130.81, 174.61, 220.00, 261.63],  /* F major      */
+    [98.00, 146.83, 196.00, 246.94, 293.66],  /* G major      */
+    [130.81, 196.00, 261.63, 329.63, 392.00]  /* C major      */
+  ];
+  var KEY = 'sss-sound';
+  var ctx = null;
+  var master = null;
+  var voices = [];
+  var timer = 0;
+  var chord = 0;
+  var running = false;
+  var wanted = false;
+
+  function pref() {
+    try { return window.localStorage.getItem(KEY) === 'on'; } catch (e) { return false; }
+  }
+  function save(on) {
+    try { window.localStorage.setItem(KEY, on ? 'on' : 'off'); } catch (e) {}
+  }
+  function reflect() {
+    btn.setAttribute('aria-pressed', running ? 'true' : 'false');
+    btn.setAttribute('aria-label', running ? 'Ambient soundtrack: on' : 'Ambient soundtrack: off');
+  }
+
+  function noiseBuffer(seconds) {
+    var rate = ctx.sampleRate;
+    var len = Math.floor(rate * seconds);
+    var buf = ctx.createBuffer(1, len, rate);
+    var data = buf.getChannelData(0);
+    for (var i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
+    return buf;
+  }
+
+  function reverbBuffer(seconds, decay) {
+    var rate = ctx.sampleRate;
+    var len = Math.floor(rate * seconds);
+    var buf = ctx.createBuffer(2, len, rate);
+    for (var c = 0; c < 2; c++) {
+      var data = buf.getChannelData(c);
+      for (var i = 0; i < len; i++) {
+        data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay);
+      }
+    }
+    return buf;
+  }
+
+  function build() {
+    ctx = new AC();
+    master = ctx.createGain();
+    master.gain.value = 0;
+    master.connect(ctx.destination);
+
+    var tone = ctx.createBiquadFilter();
+    tone.type = 'lowpass';
+    tone.frequency.value = 780;
+    tone.Q.value = 0.4;
+
+    var dry = ctx.createGain();
+    dry.gain.value = 0.9;
+    tone.connect(dry);
+    dry.connect(master);
+
+    var reverb = ctx.createConvolver();
+    reverb.buffer = reverbBuffer(3.4, 2.6);
+    var wetTone = ctx.createBiquadFilter();
+    wetTone.type = 'lowpass';
+    wetTone.frequency.value = 1600;
+    var wet = ctx.createGain();
+    wet.gain.value = 0.42;
+    tone.connect(reverb);
+    reverb.connect(wetTone);
+    wetTone.connect(wet);
+    wet.connect(master);
+
+    voices = [];
+    var notes = CHORDS[chord];
+    for (var i = 0; i < notes.length; i++) {
+      var osc = ctx.createOscillator();
+      osc.type = i === 0 ? 'triangle' : 'sine';
+      osc.frequency.value = notes[i];
+      osc.detune.value = (i % 2 ? 5 : -4) + i * 1.5;
+
+      var gain = ctx.createGain();
+      gain.gain.value = i === 0 ? 0.05 : 0.042;
+
+      var lfo = ctx.createOscillator();
+      lfo.frequency.value = 0.032 + i * 0.009;
+      var depth = ctx.createGain();
+      depth.gain.value = 0.016;
+      lfo.connect(depth);
+      depth.connect(gain.gain);
+
+      osc.connect(gain);
+      if (ctx.createStereoPanner) {
+        var pan = ctx.createStereoPanner();
+        pan.pan.value = (i - 2) * 0.17;
+        gain.connect(pan);
+        pan.connect(tone);
+      } else {
+        gain.connect(tone);
+      }
+      osc.start();
+      lfo.start();
+      voices.push(osc);
+    }
+
+    var wind = ctx.createBufferSource();
+    wind.buffer = noiseBuffer(5);
+    wind.loop = true;
+    var windFilter = ctx.createBiquadFilter();
+    windFilter.type = 'lowpass';
+    windFilter.frequency.value = 320;
+    windFilter.Q.value = 0.7;
+    var windGain = ctx.createGain();
+    windGain.gain.value = 0.05;
+    wind.connect(windFilter);
+    windFilter.connect(windGain);
+    windGain.connect(master);
+    wind.start();
+  }
+
+  function fadeTo(value, seconds) {
+    if (!ctx || !master) return;
+    var t = ctx.currentTime;
+    master.gain.cancelScheduledValues(t);
+    master.gain.setValueAtTime(master.gain.value, t);
+    master.gain.linearRampToValueAtTime(value, t + seconds);
+  }
+
+  function nextChord() {
+    if (!running || !ctx || !voices.length) return;
+    var step = 1 + Math.floor(Math.random() * (CHORDS.length - 1));
+    chord = (chord + step) % CHORDS.length;
+    var notes = CHORDS[chord];
+    var t = ctx.currentTime;
+    for (var i = 0; i < voices.length && i < notes.length; i++) {
+      voices[i].frequency.setTargetAtTime(notes[i], t, 4);
+    }
+  }
+
+  function start() {
+    if (running) return true;
+    try {
+      if (!ctx) build();
+      if (ctx.state === 'suspended' && ctx.resume) ctx.resume();
+      fadeTo(0.55, 3.2);
+      running = true;
+      window.clearInterval(timer);
+      timer = window.setInterval(nextChord, 21000);
+    } catch (e) {
+      running = false;
+      return false;
+    }
+    reflect();
+    return true;
+  }
+
+  function stop() {
+    if (!running) return;
+    running = false;
+    window.clearInterval(timer);
+    timer = 0;
+    var dying = ctx;
+    var dyingMaster = master;
+    ctx = null;
+    master = null;
+    voices = [];
+    if (dying && dyingMaster) {
+      var t = dying.currentTime;
+      dyingMaster.gain.cancelScheduledValues(t);
+      dyingMaster.gain.setValueAtTime(dyingMaster.gain.value, t);
+      dyingMaster.gain.linearRampToValueAtTime(0, t + 0.8);
+      window.setTimeout(function () {
+        try { dying.close(); } catch (e) {}
+      }, 1100);
+    }
+    reflect();
+  }
+
+  btn.addEventListener('click', function () {
+    if (running) {
+      wanted = false;
+      save(false);
+      stop();
+    } else {
+      wanted = true;
+      if (start()) save(true);
+      else {
+        wanted = false;
+        reflect();
+      }
+    }
+  });
+
+  reflect();
+  btn.hidden = false;
+
+  /* Remembered preference: browsers only allow audio after a gesture, so wait
+     for the first click or key press anywhere outside the button itself. */
+  if (pref()) {
+    wanted = true;
+    var arm = function (ev) {
+      if (ev && ev.target && btn.contains(ev.target)) return;
+      document.removeEventListener('pointerdown', arm, true);
+      document.removeEventListener('keydown', arm, true);
+      if (wanted && !running) start();
+    };
+    document.addEventListener('pointerdown', arm, true);
+    document.addEventListener('keydown', arm, true);
+  }
+})();
+</script>
+</body>
+</html>
