diff --git a/tests/render_ui.c b/tests/render_ui.c
new file mode 100644
index 0000000..74917f1
--- /dev/null
+++ b/tests/render_ui.c
@@ -0,0 +1,111 @@
+/* Headless screenshot harness: renders the real UI through gfx_soft.c. */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include "app.h"
+#include "theme.h"
+
+static App *app;
+static SsSurface *surface;
+static SsGfx *gfx;
+
+static void render(const char *path) {
+    app_draw(app, gfx);
+    surf_write_ppm(surface, path);
+    printf("wrote %s\n", path);
+}
+
+static void ev_move(float x, float y) { UiEvent e; memset(&e,0,sizeof e); e.type=UI_EV_MOVE; e.x=x; e.y=y; app_event(app,&e); }
+static void ev_down(float x, float y, int btn) { UiEvent e; memset(&e,0,sizeof e); e.type=UI_EV_DOWN; e.x=x; e.y=y; e.button=btn; app_event(app,&e); }
+static void ev_up(float x, float y) { UiEvent e; memset(&e,0,sizeof e); e.type=UI_EV_UP; e.x=x; e.y=y; app_event(app,&e); }
+static void ev_key(int k) { UiEvent e; memset(&e,0,sizeof e); e.type=UI_EV_KEY; e.key=k; app_event(app,&e); }
+static void ev_wheel(float x, float y, float d) { UiEvent e; memset(&e,0,sizeof e); e.type=UI_EV_WHEEL; e.x=x; e.y=y; e.wheel=d; app_event(app,&e); }
+static void click(float x, float y) { ev_move(x,y); ev_down(x,y,0); ev_up(x,y); }
+static void settle(int frames) { for (int i=0;i<frames;i++){ app_tick(app, 1.0/60.0); app_draw(app, gfx); } }
+
+int main(void) {
+    surface = surf_create(1280, 800);
+    gfx = gfx_create(surface);
+    app = (App*)sss_alloc(sizeof(App));
+    app_init(app, 1280, 800);
+    app->dpi = 1.0f;
+    app->ui.zoom = 46;
+    app->ui.mouse_x = 1150; app->ui.mouse_y = 700;
+    app->fps = 60;
+    settle(30);
+    render("/tmp/shot_01_overview.ppm");
+
+    /* pick Earth in the viewport: find its screen position through scene_pick candidates */
+    int earth_id = 0;
+    for (int i=0;i<app->sim.count;i++) if (app->sim.bodies[i].alive && strcmp(app->sim.bodies[i].name,"Earth")==0) earth_id = app->sim.bodies[i].id;
+    app_select(app, earth_id);
+    ev_move(430, 228); /* hover Jupiter so the readout chip is exercised */
+    settle(4);
+    render("/tmp/shot_02_selected.ppm");
+
+    /* create tab: tab bar sits at the top of the inspector */
+    click(1230, 118);
+    settle(2);
+    render("/tmp/shot_03_create.ppm");
+
+    /* detail view: focus Saturn so the rings fill the frame */
+    int saturn_id = 0;
+    for (int i = 0; i < app->sim.count; i++)
+        if (app->sim.bodies[i].alive && strcmp(app->sim.bodies[i].name, "Saturn") == 0)
+            saturn_id = app->sim.bodies[i].id;
+    app_select(app, saturn_id);
+    settle(2);
+    click(1048, 397); /* Focus */
+    settle(10);
+    render("/tmp/shot_04_focus.ppm");
+    app_reset_view(app);
+    app->ui.zoom = 46;
+
+    /* library tab: parts, texture packs and mods scanned from content/ */
+    content_init("content", "build/tmp/render_user");
+    app_rescan_content(app);
+    click(1218, 118);
+    settle(2);
+    app_apply_pack(app, 0);
+    settle(2);
+    render("/tmp/shot_11_library.ppm");
+    app_apply_pack(app, -1);
+    click(1075, 118); /* back to the create tab */
+    settle(1);
+
+    /* theme gallery: the picker itself, then every palette over the overview */
+    click(1218, 62); /* the palette button in the transport bar */
+    settle(2);
+    render("/tmp/shot_05_themes.ppm");
+    click(1218, 62);
+
+    app_select(app, earth_id);
+    app_reset_view(app);
+    app->ui.zoom = 46;
+    for (int i = 0; i < sss_theme_count(); i++) {
+        app_set_theme(app, i);
+        char path[128];
+        snprintf(path, sizeof(path), "/tmp/shot_%02d_theme_%s.ppm", 6 + i, sss_theme_at(i)->id);
+        settle(2);
+        render(path);
+    }
+    app_set_theme(app, 0);
+
+    /* simulation panel: start date, view switches, auto track, separation */
+    app_select(app, earth_id);
+    app_reset_view(app);
+    app->ui.zoom = 46;
+    ev_key('C');
+    settle(2);
+    app->sim.paused = 1;
+    app_set_start_date(app, 2029, 11, 29);
+    app_set_track(app, saturn_id);
+    settle(30);
+    render("/tmp/shot_12_simulation.ppm");
+    click(150, 413); /* auto-track dropdown */
+    settle(2);
+    render("/tmp/shot_13_track.ppm");
+
+    printf("done\n");
+    return 0;
+}
diff --git a/tests/test_content.c b/tests/test_content.c
new file mode 100644
index 0000000..c1ed695
--- /dev/null
+++ b/tests/test_content.c
@@ -0,0 +1,194 @@
+/* tests/test_content.c -- the drop-in content folders: parts, texture packs,
+ * mods, log writing and the tiny key=value parser. */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include "content.h"
+#include "sim.h"
+
+static int fails = 0;
+static void unbuf(void) { setvbuf(stdout, NULL, _IONBF, 0); }
+#define CHECK(cond, msg, ...) do { if (!(cond)) { printf("FAIL: " msg "\n", ##__VA_ARGS__); fails++; } else { printf("ok   : " msg "\n", ##__VA_ARGS__); } } while (0)
+
+static void mkdir_p(const char *path) {
+    char tmp[512];
+    snprintf(tmp, sizeof(tmp), "%s", path);
+    for (int i = 1; tmp[i]; i++) {
+        if (tmp[i] == '/') {
+            tmp[i] = 0;
+            mkdir(tmp, 0775);
+            tmp[i] = '/';
+        }
+    }
+    mkdir(tmp, 0775);
+}
+
+static void write_file(const char *path, const char *text) {
+    FILE *f = fopen(path, "wb");
+    if (!f) { printf("FAIL: cannot write %s\n", path); fails++; return; }
+    fwrite(text, 1, strlen(text), f);
+    fclose(f);
+}
+
+static int file_has(const char *path, const char *needle) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return 0;
+    static char buf[8192];
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    buf[n] = 0;
+    fclose(f);
+    return strstr(buf, needle) != NULL;
+}
+
+int main(void) {
+    unbuf();
+    const char *base = "build/tmp/content_test";
+    char app[512], user[512], p[640];
+    mkdir_p(base);
+    snprintf(app, sizeof(app), "%s/app", base);
+    snprintf(user, sizeof(user), "%s/user", base);
+
+    /* a clean slate */
+    char cmd[640];
+    snprintf(cmd, sizeof(cmd), "rm -rf '%s'", base);
+    if (system(cmd) != 0) { /* first run has nothing to delete */ }
+    mkdir_p(base);
+    mkdir_p(app);
+    mkdir_p(user);
+
+    /* --- colour parser -------------------------------------------------- */
+    SsColor c;
+    CHECK(content_parse_color("#ff8000", &c) && ((c >> 16) & 255) == 255 &&
+              ((c >> 8) & 255) == 128 && (c & 255) == 0,
+          "hex colour #ff8000");
+    CHECK(content_parse_color("#f80", &c) && ((c >> 16) & 255) == 255 &&
+              ((c >> 8) & 255) == 136 && (c & 255) == 0,
+          "short hex colour #f80");
+    CHECK(content_parse_color(" 12, 34, 56 ", &c) && ((c >> 16) & 255) == 12 &&
+              ((c >> 8) & 255) == 34 && (c & 255) == 56,
+          "r,g,b colour");
+    CHECK(!content_parse_color("#12", &c), "bad hex rejected");
+    CHECK(!content_parse_color("hello", &c), "text rejected");
+
+    /* --- kind names ---------------------------------------------------- */
+    CHECK(content_kind_from_name("star") == BT_STAR, "kind star");
+    CHECK(content_kind_from_name("GIANT") == BT_GIANT, "kind is case insensitive");
+    CHECK(content_kind_from_name("blackhole") == BT_BLACKHOLE, "kind blackhole");
+    CHECK(content_kind_from_name("gas giant") == BT_GIANT, "kind ignores spaces");
+    CHECK(content_kind_from_name("Black Hole") == BT_BLACKHOLE, "kind ignores case and spaces");
+    CHECK(content_kind_from_name("planet") == BT_TERRESTRIAL, "kind alias planet");
+    CHECK(content_kind_from_name("krypton") == -1, "unknown kind -> -1");
+    CHECK(content_kind_from_name(NULL) == -1, "missing kind -> -1");
+
+    /* --- content on disk ----------------------------------------------- */
+    snprintf(p, sizeof(p), "%s/Parts", app);
+    mkdir_p(p);
+    write_file("build/tmp/content_test/app/Parts/Ocean.part",
+               "# a test part\n"
+               "name = Ocean World\n"
+               "kind = terrestrial\n"
+               "mass = 5.97e24\n"
+               "radius = 6371\n"
+               "orbit = 1.0\n"
+               "ecc = 0.02\n"
+               "color1 = #6ec0e8\n"
+               "color2 = #123a66\n"
+               "accent = #8fd8ff\n"
+               "note = Temperate ocean world\n");
+    write_file("build/tmp/content_test/app/Parts/rings.part",
+               "kind=ice\n"
+               "rings=1\n"
+               "ring_in=1.5\n"
+               "ring_out=2.1\n"
+               "ring_color=210,230,240,170\n");
+    snprintf(p, sizeof(p), "%s/Texture Pack/Deep Blue", app);
+    mkdir_p(p);
+    write_file("build/tmp/content_test/app/Texture Pack/Deep Blue/pack.ini",
+               "name = Deep Blue\nnote = cold starlight\ntint = #5aa0ff\nstrength = 45\n");
+    snprintf(p, sizeof(p), "%s/Mods/Custom_", app);
+    mkdir_p(p);
+    write_file("build/tmp/content_test/app/Mods/Custom_/sample.sims", "SSS1\nsim 0 1 0 1 0 1\n");
+    snprintf(p, sizeof(p), "%s/Parts", user);
+    mkdir_p(p);
+    write_file("build/tmp/content_test/user/Parts/user.part", "name = User Part\nmass = 1e22\n");
+
+    CHECK(content_init(app, user) == 1, "content_init succeeds");
+    CHECK(content_dir(CF_PARTS) != NULL && strstr(content_dir(CF_PARTS), "user") != NULL,
+          "content_dir prefers the writable user root");
+    CHECK(content_app_dir(CF_PARTS) != NULL && strstr(content_app_dir(CF_PARTS), "app") != NULL,
+          "content_app_dir is the app root");
+
+    CHECK(content_part_count() == 3, "scanned 3 parts, got %d", content_part_count());
+    CHECK(content_pack_count() == 1, "scanned 1 pack, got %d", content_pack_count());
+    CHECK(content_mod_count() == 1, "scanned 1 mod, got %d", content_mod_count());
+
+    const ContentPart *ocean = NULL, *rings = NULL, *userpart = NULL;
+    for (int i = 0; i < content_part_count(); i++) {
+        const ContentPart *part = content_part(i);
+        if (strcmp(part->name, "Ocean World") == 0) ocean = part;
+        if (strcmp(part->name, "rings") == 0) rings = part;
+        if (strcmp(part->name, "User Part") == 0) userpart = part;
+    }
+    CHECK(ocean != NULL, "part keeps its name");
+    if (ocean) {
+        CHECK(content_kind_from_name(ocean->kind) == BT_TERRESTRIAL, "part kind parsed");
+        CHECK(ocean->mass_kg > 5.9e24 && ocean->mass_kg < 6.0e24, "part mass %.3g", ocean->mass_kg);
+        CHECK(ocean->radius_km == 6371, "part radius %.1f", ocean->radius_km);
+        CHECK(((ocean->col1 >> 16) & 255) == 0x6e && ((ocean->col1 >> 8) & 255) == 0xc0 &&
+                  (ocean->col1 & 255) == 0xe8,
+              "part colour parsed");
+        CHECK(ocean->orbit_au == 1.0 && ocean->ecc == 0.02, "part orbit and eccentricity");
+        CHECK(strstr(ocean->note, "Temperate") != NULL, "part note parsed");
+    }
+    CHECK(rings != NULL, "part with no name falls back to the file name");
+    if (rings) {
+        CHECK(rings->ringed == 1 && rings->ring_in == 1.5 && rings->ring_out == 2.1,
+              "ring fields parsed");
+        CHECK(rings->mass_kg == 5.97e24, "part defaults fill missing mass");
+    }
+    CHECK(userpart != NULL, "user root parts are scanned too");
+
+    const ContentPack *pack = content_pack(0);
+    CHECK(pack != NULL, "pack present");
+    if (pack) {
+        CHECK(strcmp(pack->name, "Deep Blue") == 0, "pack name");
+        CHECK(pack->strength == 45, "pack strength %d", pack->strength);
+        CHECK((pack->tint & 255) == 0xff, "pack tint parsed");
+        CHECK(strstr(pack->file, "Deep Blue") != NULL, "pack keeps its folder");
+    }
+    CHECK(content_mod_count() == 1 && strstr(content_mod(0)->file, "sample.sims") != NULL,
+          "mod file recorded");
+
+    /* --- log ----------------------------------------------------------- */
+    content_log("test started, %d parts", content_part_count());
+    char log[640];
+    snprintf(log, sizeof(log), "%s/app.log", content_dir(CF_LOGS));
+    CHECK(file_has(log, "test started, 3 parts"), "log line written to %s", log);
+    CHECK(file_has(log, "20"), "log line starts with a timestamp");
+    content_log("second line");
+    CHECK(file_has(log, "second line"), "log appends a second line");
+
+    /* --- rescan picks up new files ------------------------------------- */
+    write_file("build/tmp/content_test/user/Parts/late.part", "name = Late\nkind = comet\n");
+    content_scan();
+    CHECK(content_part_count() == 4, "rescan finds the new part (%d)", content_part_count());
+    int late = -1;
+    for (int i = 0; i < content_part_count(); i++)
+        if (strcmp(content_part(i)->name, "Late") == 0) late = i;
+    CHECK(late >= 0 && content_kind_from_name(content_part(late)->kind) == BT_COMET,
+          "new part classified as a comet");
+
+    /* --- folders are created on demand --------------------------------- */
+    char dir[640];
+    snprintf(dir, sizeof(dir), "%s/Saving", user);
+    struct stat st;
+    CHECK(stat(dir, &st) == 0 && S_ISDIR(st.st_mode), "Saving folder created in the user root");
+    snprintf(dir, sizeof(dir), "%s/Logs", user);
+    CHECK(stat(dir, &st) == 0 && S_ISDIR(st.st_mode), "Logs folder created in the user root");
+
+    content_shutdown();
+    printf(fails == 0 ? "\nALL CONTENT TESTS PASSED\n" : "\n%d CONTENT TEST(S) FAILED\n", fails);
+    return fails == 0 ? 0 : 1;
+}
diff --git a/tests/test_payload.c b/tests/test_payload.c
new file mode 100644
index 0000000..024c64a
--- /dev/null
+++ b/tests/test_payload.c
@@ -0,0 +1,147 @@
+/* test_payload.c -- host-side checks for the installer payload.
+ *
+ * Builds and runs on Linux (the parser is deliberately platform neutral):
+ *
+ *   cc -std=c99 -O1 -Isrc tests/test_payload.c src/installer/payload.c src/core.c \
+ *      -lm -o /tmp/test_payload
+ *   /tmp/test_payload build/payload.bin build/payload
+ *
+ * It verifies the blob produced by tools/make_payload.py, walks every entry,
+ * checks the CRC and writes the files out so byte equality can be compared
+ * against the directory that was packed.
+ */
+#include "installer/setup.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int failures;
+
+static void check(int cond, const char *what) {
+    if (cond) {
+        printf("  ok    %s\n", what);
+    } else {
+        printf("  FAIL  %s\n", what);
+        failures++;
+    }
+}
+
+static unsigned char *read_file(const char *path, unsigned int *size) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    long len = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (len < 0) {
+        fclose(f);
+        return NULL;
+    }
+    unsigned char *buffer = (unsigned char *)malloc((size_t)len ? (size_t)len : 1);
+    if (!buffer) {
+        fclose(f);
+        return NULL;
+    }
+    size_t got = fread(buffer, 1, (size_t)len, f);
+    fclose(f);
+    if ((long)got != len) {
+        free(buffer);
+        return NULL;
+    }
+    *size = (unsigned int)len;
+    return buffer;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s payload.bin packed-dir\n", argv[0]);
+        return 2;
+    }
+    unsigned int size = 0;
+    unsigned char *blob = read_file(argv[1], &size);
+    if (!blob) {
+        fprintf(stderr, "cannot read %s\n", argv[1]);
+        return 2;
+    }
+
+    printf("payload parser\n");
+    Payload payload;
+    check(payload_open(&payload, blob, size) == 1, "payload header and table parse");
+    check(payload.count >= 2, "payload has entries");
+    check(strcmp(payload_meta(&payload, "product"), "Solar System Sandbox") == 0, "product name");
+    check(strcmp(payload_meta(&payload, "version"), "1.0.0") == 0, "product version");
+
+    int crc_ok = 1;
+    int has_ini = 0;
+    int has_exe = 0;
+    int has_parts = 0;
+    int has_pack = 0;
+    int has_mod = 0;
+    int has_saving = 0;
+    for (int i = 0; i < payload.count; i++) {
+        const PayloadEntry *e = &payload.entries[i];
+        if (sss_crc32(e->data, e->size) != e->crc) {
+            printf("  bad crc: %s\n", e->name);
+            crc_ok = 0;
+        }
+        if (strcmp(e->name, "setup.ini") == 0) has_ini = 1;
+        if (strstr(e->name, "SolarSandbox.exe")) has_exe = 1;
+        if (strstr(e->name, "Parts/") && strstr(e->name, ".part")) has_parts = 1;
+        if (strstr(e->name, "Texture Pack/") && strstr(e->name, "pack.ini")) has_pack = 1;
+        if (strstr(e->name, "Mods/Custom_/") && strstr(e->name, ".sims")) has_mod = 1;
+        if (strcmp(e->name, "Saving/README.txt") == 0) has_saving = 1;
+    }
+    check(crc_ok, "every entry passes its CRC-32");
+    check(has_ini, "setup.ini metadata entry present");
+    check(has_exe, "application executable present");
+    check(has_parts, "sample Parts/*.part templates packed");
+    check(has_pack, "sample Texture Pack/<name>/pack.ini packed");
+    check(has_mod, "sample Mods/Custom_/*.sims scenario packed");
+    check(has_saving, "Saving folder marker packed");
+
+    /* Every packed file must appear in the payload with identical bytes. */
+    int all_files_found = 1;
+    for (int i = 0; i < payload.count; i++) {
+        const PayloadEntry *e = &payload.entries[i];
+        if (strcmp(e->name, "setup.ini") == 0) continue;
+        char path[1024];
+        snprintf(path, sizeof(path), "%s/%s", argv[2], e->name);
+        unsigned int file_size = 0;
+        unsigned char *file = read_file(path, &file_size);
+        if (!file) {
+            printf("  missing on disk: %s\n", path);
+            all_files_found = 0;
+            continue;
+        }
+        if (file_size != e->size || memcmp(file, e->data, file_size) != 0) {
+            printf("  byte mismatch: %s\n", e->name);
+            all_files_found = 0;
+        }
+        free(file);
+    }
+    check(all_files_found, "payload bytes match the packed directory");
+
+    /* Negative cases: a truncated blob and a corrupted magic must be rejected. */
+    check(payload_open(&payload, blob, 12) == 0, "truncated header rejected");
+    unsigned char *broken = (unsigned char *)malloc(size);
+    memcpy(broken, blob, size);
+    broken[0] = 'X';
+    check(payload_open(&payload, broken, size) == 0, "bad magic rejected");
+    memcpy(broken, blob, size);
+    broken[size - 1] ^= 0xFF; /* corrupt the last payload byte */
+    Payload second;
+    int parsed = payload_open(&second, broken, size);
+    int crc_failed = 1;
+    if (parsed) {
+        crc_failed = 0;
+        for (int i = 0; i < second.count; i++)
+            if (sss_crc32(second.entries[i].data, second.entries[i].size) != second.entries[i].crc)
+                crc_failed = 1;
+    }
+    check(parsed && crc_failed, "corrupted file data fails the CRC check");
+    free(broken);
+    free(blob);
+
+    printf(failures ? "\nFAILED (%d)\n" : "\nALL PAYLOAD TESTS PASSED\n", failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/test_sim.c b/tests/test_sim.c
new file mode 100644
index 0000000..15a331e
--- /dev/null
+++ b/tests/test_sim.c
@@ -0,0 +1,82 @@
+#include <stdio.h>
+#include <math.h>
+#include <string.h>
+#include "sim.h"
+
+static int fails = 0;
+static void unbuf(void) { setvbuf(stdout, NULL, _IONBF, 0); }
+#define CHECK(cond, msg, ...) do { if (!(cond)) { printf("FAIL: " msg "\n", ##__VA_ARGS__); fails++; } else { printf("ok   : " msg "\n", ##__VA_ARGS__); } } while (0)
+
+static int find(Sim *s, const char *n) { for (int i=0;i<s->count;i++) if (s->bodies[i].alive && !strcmp(s->bodies[i].name,n)) return i; return -1; }
+
+int main(void) {
+    unbuf();
+    static Sim s; sim_init(&s);
+    double jd = date_to_jd(2026, 10, 18, 0, 0, 0);
+    printf("J2000 days for 2026-10-18: %.4f\n", jd);
+    int y,m,d,h,mi,se; jd_to_date(jd, &y,&m,&d,&h,&mi,&se);
+    CHECK(y==2026 && m==10 && d==18, "date roundtrip -> %04d-%02d-%02d %02d:%02d:%02d", y,m,d,h,mi,se);
+    double jd2 = date_to_jd(2000,1,1,12,0,0);
+    CHECK(fabs(jd2) < 1e-9, "J2000 epoch maps to 0 days (%.6f)", jd2);
+
+    sim_load_preset(&s, PRESET_FULL, jd);
+    CHECK(s.count == 40, "full preset body count = %d (1 sun + 9 planets + 9 small + 21 moons)", s.count);
+    int e = find(&s, "Earth"), j = find(&s, "Jupiter"), sa = find(&s, "Saturn");
+    CHECK(e>=0 && j>=0 && sa>=0, "planets present");
+    double de = body_distance_to_parent(&s.bodies[e], &s);
+    double dj = body_distance_to_parent(&s.bodies[j], &s);
+    double ds = body_distance_to_parent(&s.bodies[sa], &s);
+    printf("     distances: Earth %.4f AU, Jupiter %.4f AU, Saturn %.4f AU\n", de, dj, ds);
+    CHECK(de > 0.95 && de < 1.05, "Earth near 1 AU at 2026-10-18 (%.4f)", de);
+    CHECK(dj > 4.0 && dj < 6.5, "Jupiter in range (%.3f)", dj);
+    CHECK(ds > 8.0 && ds < 11.2, "Saturn in range (%.3f)", ds);
+    double pe = body_orbit_period(&s.bodies[e], &s) / 365.25;
+    double pj = body_orbit_period(&s.bodies[j], &s) / 365.25;
+    CHECK(fabs(pe-1.0) < 0.02, "Earth period %.3f y", pe);
+    CHECK(fabs(pj-11.86) < 0.1, "Jupiter period %.3f y", pj);
+
+    /* advance 30 days, Earth should have moved ~29.5 deg */
+    Vec3 p0 = s.bodies[e].wpos;
+    double ang0 = atan2(p0.y, p0.x);
+    s.speed = 1.0; /* day per second */
+    for (int i=0;i<120;i++) sim_advance(&s, 0.25);
+    Vec3 p1 = s.bodies[e].wpos;
+    double ang1 = atan2(p1.y, p1.x);
+    double swept = fmod(ang1 - ang0 + TAU*2, TAU) * RAD2DEG;
+    printf("     30 days swept %.2f deg (expected ~29.7)\n", swept);
+    CHECK(fabs(swept - 29.7) < 1.0, "Earth swept %.2f deg in 30 days", swept);
+
+    /* save/load roundtrip */
+    static char buf[400000]; Str out; str_init(&out, buf, sizeof(buf));
+    sim_save(&s, &out);
+    printf("     save size %d bytes\n", out.len);
+    static Sim t; sim_init(&t);
+    CHECK(sim_load(&t, buf) == 1, "load succeeds");
+    CHECK(t.count == s.count, "roundtrip count %d == %d", t.count, s.count);
+    int e2 = find(&t, "Earth");
+    CHECK(e2 >= 0 && fabs(t.bodies[e2].wpos.x - s.bodies[e].wpos.x) < 1e-6, "Earth position preserved");
+    int moon = find(&t, "Moon");
+    CHECK(moon >= 0 && t.bodies[moon].parent == e2, "Moon parent remapped to Earth");
+    double dm = body_distance_to_parent(&t.bodies[moon], &t);
+    CHECK(dm*KM_PER_AU > 3.0e5 && dm*KM_PER_AU < 4.5e5, "Moon distance %.0f km", dm*KM_PER_AU);
+
+    /* nbody sandbox: circular orbit should stay circular for a year */
+    sim_load_preset(&t, PRESET_EMPTY, 0);
+    Body proto; memset(&proto,0,sizeof(proto));
+    strcpy(proto.name, "TestRock"); proto.kind = BT_ASTEROID; proto.mass_kg = 1e20; proto.radius_km = 500;
+    proto.col1 = RGB_A(200,180,160); proto.col2 = RGB_A(90,80,70); proto.accent = RGB_A(200,180,160);
+    Vec3 pos = {2.0, 0, 0}, vel; sim_circular_velocity(&t, pos, t.bodies[0].mass_kg, &vel);
+    int rock = sim_add_body(&t, &proto, pos, vel, -1);
+    t.nbody = 1; t.speed = 30.0;
+    for (int i=0;i<400;i++) sim_advance(&t, 0.05);
+    double rr = sqrt(t.bodies[rock].wpos.x*t.bodies[rock].wpos.x + t.bodies[rock].wpos.y*t.bodies[rock].wpos.y);
+    double days = t.t;
+    printf("     nbody: %.1f days later r=%.5f AU, z=%.5f\n", days, rr, t.bodies[rock].wpos.z);
+    CHECK(fabs(rr-2.0) < 0.02, "circular orbit radius preserved (%.4f)", rr);
+    CHECK(t.bodies[rock].trail_count > 50, "trail recorded (%d)", t.bodies[rock].trail_count);
+
+    sim_load_preset(&t, PRESET_BINARY, 0);
+    CHECK(t.count == 5 && t.nbody == 1, "binary preset loads (%d bodies)", t.count);
+    printf("\n%s (%d failures)\n", fails ? "TESTS FAILED" : "ALL TESTS PASSED", fails);
+    return fails ? 1 : 0;
+}
diff --git a/tests/test_ui.c b/tests/test_ui.c
new file mode 100644
index 0000000..8b5febb
--- /dev/null
+++ b/tests/test_ui.c
@@ -0,0 +1,199 @@
+/* Headless checks for the simulation panel: start date, view switches,
+ * auto-track picker and the object-separation readout.
+ *
+ * The clicks use offsets inside ui.panel_rect / ui.picker_rect, so the layout
+ * can move without invalidating the test.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include "app.h"
+#include "theme.h"
+
+static App *app;
+static SsSurface *surf;
+static SsGfx *g;
+static int failures;
+
+#define CHECK(c, msg) do { if (!(c)) { printf("FAIL %s (line %d)\n", msg, __LINE__); failures++; } } while (0)
+
+static void draw(void) { app_draw(app, g); }
+
+static void ev_move(float x, float y) { UiEvent e; memset(&e, 0, sizeof e); e.type = UI_EV_MOVE; e.x = x; e.y = y; app_event(app, &e); }
+static void ev_down(float x, float y, int b) { UiEvent e; memset(&e, 0, sizeof e); e.type = UI_EV_DOWN; e.x = x; e.y = y; e.button = b; app_event(app, &e); }
+static void ev_up(float x, float y) { UiEvent e; memset(&e, 0, sizeof e); e.type = UI_EV_UP; e.x = x; e.y = y; app_event(app, &e); }
+static void ev_key(int k) { UiEvent e; memset(&e, 0, sizeof e); e.type = UI_EV_KEY; e.key = k; app_event(app, &e); }
+static void click(float x, float y) { ev_move(x, y); ev_down(x, y, 0); ev_up(x, y); }
+
+static int body_index(const char *name) {
+    for (int i = 0; i < app->sim.count; i++)
+        if (app->sim.bodies[i].alive && strcmp(app->sim.bodies[i].name, name) == 0) return i;
+    return -1;
+}
+
+static int alive_rank(int body_idx) {
+    int n = 0;
+    for (int i = 0; i < app->sim.count; i++) {
+        if (!app->sim.bodies[i].alive) continue;
+        if (i == body_idx) return n;
+        n++;
+    }
+    return -1;
+}
+
+/* Panel layout, in dpi-scaled pixels from the panel origin. */
+#define PANEL_PAD     (16.0f)
+#define DATE_TOP      (38.0f)
+#define FIELD_TOP     (DATE_TOP + 16.0f)
+#define FIELD_UP_Y    (FIELD_TOP + 43.0f)
+#define SET_Y         (FIELD_TOP + 61.0f)
+#define VIEW_TOP      (SET_Y + 32.0f + 16.0f)
+#define TRACK_Y       (VIEW_TOP + 5 * 22.0f + 6.0f + 16.0f)
+#define SEP_Y         (TRACK_Y + 34.0f + 16.0f)
+
+int main(void) {
+    surf = surf_create(1280, 800);
+    g = gfx_create(surf);
+    app = (App *)sss_alloc(sizeof(App));
+    app_init(app, 1280, 800);
+    app->dpi = 1.0f;
+    app->fps = 60;
+    draw();
+
+    ev_key('C');
+    draw();
+    CHECK(app->ui.panel_open == 1, "C opens the controls panel");
+    SsRect p = app->ui.panel_rect;
+    CHECK(p.w > 280 && p.h > 400, "panel has a sensible size");
+    CHECK(app->ui.date_year >= 1800 && app->ui.date_month >= 1 && app->ui.date_month <= 12,
+          "date fields mirror sim.t");
+
+    /* pointer drags over the panel must not move the camera */
+    Vec3 before = app->ui.center;
+    ev_down(p.x + 100, p.y + 200, 0);
+    ev_move(p.x + 220, p.y + 200);
+    ev_up(p.x + 220, p.y + 200);
+    CHECK(fabs(app->ui.center.x - before.x) < 1e-9 &&
+          fabs(app->ui.center.y - before.y) < 1e-9, "panel swallows drags");
+
+    /* year / month / day steppers, then Set start date */
+    int y0 = app->ui.date_year, m0 = app->ui.date_month;
+    float yw = 88.0f, mw = 56.0f, gap = 8.0f;
+    for (int i = 0; i < 3; i++) click(p.x + PANEL_PAD + yw * 0.75f, p.y + FIELD_UP_Y);
+    click(p.x + PANEL_PAD + yw + gap + mw * 0.75f, p.y + FIELD_UP_Y);
+    CHECK(app->ui.date_year == y0 + 3, "year stepper adds three years");
+    CHECK(app->ui.date_month == (m0 % 12) + 1, "month stepper wraps December to January");
+    click(p.x + PANEL_PAD + 70, p.y + SET_Y + 13);
+    draw();
+    double want = date_to_jd(app->ui.date_year, app->ui.date_month, app->ui.date_day, 0, 0, 0);
+    CHECK(fabs(app->sim.t - want) < 1e-6, "Set start date drives sim.t");
+
+    /* view switches (row 0 right, row 2 left, row 3 left) */
+    float cellw = (p.w - 32 - 8) * 0.5f;
+    click(p.x + PANEL_PAD + cellw + 20, p.y + VIEW_TOP + 10);
+    draw();
+    CHECK(app->ui.show_fade_orbits == 1, "fade orbits toggles");
+    click(p.x + PANEL_PAD + 20, p.y + VIEW_TOP + 2 * 22 + 10);
+    draw();
+    CHECK(app->ui.show_sun == 0, "sun toggles");
+    click(p.x + PANEL_PAD + 20, p.y + VIEW_TOP + 3 * 22 + 10);
+    draw();
+    CHECK(app->ui.simplified == 1, "simplified toggles");
+    click(p.x + PANEL_PAD + 20, p.y + VIEW_TOP + 2 * 22 + 10);
+    click(p.x + PANEL_PAD + 20, p.y + VIEW_TOP + 3 * 22 + 10);
+    click(p.x + PANEL_PAD + cellw + 20, p.y + VIEW_TOP + 10);
+
+    /* auto track: open the popup and click Earth */
+    int earth = body_index("Earth");
+    CHECK(earth >= 0, "Earth exists in the full preset");
+    click(p.x + PANEL_PAD + 40, p.y + TRACK_Y + 14);
+    draw();
+    CHECK(app->ui.picker_open == 1 && app->ui.picker_target == 1, "track picker opens");
+    float row_y = app->ui.picker_rect.y + 34 + (alive_rank(earth) + 1) * 25 + 12;
+    click(app->ui.picker_rect.x + 30, row_y);
+    draw();
+    CHECK(app->ui.picker_open == 0, "picking a body closes the popup");
+    CHECK(app->ui.follow_id == app->sim.bodies[earth].id, "auto track follows Earth");
+
+    /* object separation: clear B, then read Sun-Earth */
+    click(p.x + PANEL_PAD + (p.w - 32 + 8) * 0.5f + 20, p.y + SEP_Y + 14);
+    draw();
+    CHECK(app->ui.picker_open == 1 && app->ui.picker_target == 3, "separation picker opens");
+    click(app->ui.picker_rect.x + 30, app->ui.picker_rect.y + 34 + 12);
+    draw();
+    CHECK(app->ui.sep_b_id == 0, "separation B clears");
+    CHECK(app_separation_au(app, app->ui.sep_a_id, app->ui.sep_b_id) < 0,
+          "no distance without B");
+
+    app->ui.sep_a_id = app->sim.bodies[body_index("Sun")].id;
+    app->ui.sep_b_id = app->sim.bodies[body_index("Earth")].id;
+    double au = app_separation_au(app, app->ui.sep_a_id, app->ui.sep_b_id);
+    CHECK(au > 0.9 && au < 1.1, "Sun-Earth separation is about one AU");
+
+    /* start date clamping, leap years */
+    app_set_start_date(app, 1700, 13, 40);
+    CHECK(app->ui.date_year == 1800 && app->ui.date_month == 12 &&
+          app->ui.date_day == 31, "start date clamps to 1800-12-31");
+    app_set_start_date(app, 2100, 2, 30);
+    CHECK(app->ui.date_year == 2100 && app->ui.date_month == 2 &&
+          app->ui.date_day == 28, "2100 is not a leap year");
+    app_set_start_date(app, 2029, 11, 29);
+    CHECK(fabs(app->sim.t - date_to_jd(2029, 11, 29, 0, 0, 0)) < 1e-6,
+          "2029-11-29 lands at midnight UTC");
+
+    /* Escape closes the panel */
+    ev_key(UI_KEY_ESC);
+    draw();
+    CHECK(app->ui.panel_open == 0, "Escape closes the panel");
+
+    /* A 1024x600-class window: the panel scrolls instead of overflowing. */
+    App *big_app = app;
+    SsGfx *big_g = g;
+    SsSurface *small_surf = surf_create(1008, 481);
+    SsGfx *small_g = gfx_create(small_surf);
+    App *small = (App *)sss_alloc(sizeof(App));
+    app_init(small, 1008, 481);
+    small->dpi = 1.0f;
+    small->fps = 60;
+    app = small;
+    g = small_g;
+    draw();
+    ev_key('C');
+    draw();
+    SsRect sp = small->ui.panel_rect;
+    CHECK(sp.y + sp.h <= 481 - 26, "panel stops above the status bar");
+    CHECK(small->ui.panel_scroll_max > 0, "short windows expose a scroll range");
+    CHECK(small->ui.panel_scroll == 0, "panel starts at the top");
+    UiEvent we;
+    memset(&we, 0, sizeof we);
+    we.type = UI_EV_WHEEL;
+    we.x = sp.x + 100;
+    we.y = sp.y + 200;
+    we.wheel = -1;
+    app_event(small, &we);
+    draw();
+    CHECK(small->ui.panel_scroll > 0, "wheel scrolls the panel");
+    float sep_y = sp.y + SEP_Y + 14 - small->ui.panel_scroll;
+    click(sp.x + PANEL_PAD + 40, sep_y);
+    draw();
+    CHECK(small->ui.picker_open == 1 && small->ui.picker_target == 2,
+          "separation A is reachable after scrolling");
+    ev_key(UI_KEY_ESC);   /* the picker first */
+    ev_key(UI_KEY_ESC);   /* then the panel */
+    CHECK(small->ui.panel_open == 0, "Escape closes the short panel");
+
+    /* the lighter scene path renders without changing the simulation */
+    small->ui.low_power = 1;
+    double t_before = small->sim.t;
+    draw();
+    CHECK(fabs(small->sim.t - t_before) < 1e-9, "low-power draw leaves the clock alone");
+
+    gfx_destroy(small_g);
+    surf_destroy(small_surf);
+    sss_free(small);
+    app = big_app;
+    g = big_g;
+
+    printf(failures ? "RESULT FAIL (%d)\n" : "RESULT PASS\n", failures);
+    return failures ? 1 : 0;
+}
